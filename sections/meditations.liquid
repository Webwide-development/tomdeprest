{% if customer %}

    <h1>Mijn meditaties</h1>

    {% if customer.tags contains 'meditatie-slaap' %}
        <div class="meditation-item">
            <h2>Diepe slaap meditatie</h2>

            <iframe 
                src="https://player.vimeo.com/video/123456789"
                width="100%"
                height="500"
                frameborder="0"
                allow="autoplay; fullscreen"
                allowfullscreen>
            </iframe>
        </div>
    {% endif %}

{% else %}

    <script>
        window.location.href = "/account/login";
    </script>

{% endif %}