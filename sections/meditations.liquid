<style>
  #shopify-section-{{ section.id }} .meditations {
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .meditations__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .meditations__grid {
    display: grid;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .meditations__card {
    padding: 0 0 24px;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .meditations__card:last-child {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .meditations__card-header {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 48px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .meditations__image-wrapper {
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
    height: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .meditations__image-wrapper img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .meditations__content h2 {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 2.8vw, 34px);
    font-weight: 400;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .meditations__description {
    max-width: 520px;
    margin-bottom: 32px;
    color: rgba(var(--color-foreground), 0.66);
    font-size: 14px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .meditations__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .meditations__notice,
  #shopify-section-{{ section.id }} .meditations__empty p,
  #shopify-section-{{ section.id }} .meditations__login-required p,
  #shopify-section-{{ section.id }} .meditations__no-products {
    margin: 0;
    color: rgba(var(--color-foreground), 0.66);
    font-size: 14px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .meditations__video-wrapper {
    margin-top: 24px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #111;
  }

  #shopify-section-{{ section.id }} .meditations__video-wrapper iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  #shopify-section-{{ section.id }} .meditations__empty,
  #shopify-section-{{ section.id }} .meditations__login-required {
    max-width: 560px;
    margin: 0 auto;
    padding: 48px 32px;
    text-align: center;
    border: 1px solid rgba(var(--color-foreground), 0.16);
    background: rgba(var(--color-foreground), 0.025);
  }

  #shopify-section-{{ section.id }} .meditations__login-required h2 {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .meditations__empty .button-base,
  #shopify-section-{{ section.id }} .meditations__login-required .button-base {
    margin-top: 22px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .meditations__inner {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .meditations__card-header {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .meditations__image-wrapper {
      aspect-ratio: 16 / 9;
    }
  }
</style>

{% capture children %}
  {% liquid
    assign meditation_collection = section.settings.collection
    assign has_access_to_any_meditation = false
  %}

  <div class="meditations">
    <div class="meditations__inner">
      {% if customer %}
        {% if meditation_collection and meditation_collection.products_count > 0 %}
          <div class="meditations__grid">
            {% for product in meditation_collection.products %}
              {% liquid
                assign vimeo_id = product.metafields.custom.vimeo_id.value
                assign required_tag = product.metafields.custom.customer_tag.value
                assign has_access = false

                if required_tag != blank and customer.tags contains required_tag
                  assign has_access = true
                  assign has_access_to_any_meditation = true
                endif
              %}

              {% if has_access %}
                <article class="meditations__card">
                  <div class="meditations__card-header">
                    {% if product.featured_image != blank %}
                      <div class="meditations__image-wrapper">
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          loading="lazy"
                          width="600"
                          height="338"
                        >
                      </div>
                    {% endif %}

                    <div class="meditations__content">
                      <h2>{{ product.title }}</h2>

                      {% if product.description != blank %}
                        <div class="meditations__description">
                          {{ product.description }}
                        </div>
                      {% endif %}

                      {% if vimeo_id != blank %}
                        <button
                            type="button"
                            class="button-base button-secondary meditations__toggle"
                            aria-expanded="false"
                            aria-controls="meditation-video-{{ product.id }}"
                            aria-label="{{ section.settings.open_button_label | escape }}: {{ product.title | escape }}"
                            data-open-label="{{ section.settings.open_button_label | escape }}"
                            data-close-label="{{ section.settings.close_button_label | escape }}"
                        >
                            {{ section.settings.open_button_label }}
                        </button>
                      {% else %}
                        <p class="meditations__notice">
                          {{ section.settings.missing_video_text }}
                        </p>
                      {% endif %}
                    </div>
                  </div>

                  {% if vimeo_id != blank %}
                    <div
                      id="meditation-video-{{ product.id }}"
                      class="meditations__video-wrapper"
                      hidden
                    >
                      <iframe
                        data-src="https://player.vimeo.com/video/{{ vimeo_id }}"
                        width="100%"
                        height="500"
                        frameborder="0"
                        allow="autoplay; fullscreen; picture-in-picture"
                        allowfullscreen
                        loading="lazy">
                      </iframe>
                    </div>
                  {% endif %}
                </article>
              {% endif %}
            {% endfor %}
          </div>

          {% unless has_access_to_any_meditation %}
            <div class="meditations__empty">
              <p>{{ section.settings.empty_text }}</p>

              {% if section.settings.empty_button_url != blank %}
                <a href="{{ section.settings.empty_button_url }}" class="button-base button-secondary">
                  {{ section.settings.empty_button_label }}
                </a>
              {% endif %}
            </div>
          {% endunless %}
        {% else %}
          <p class="meditations__no-products">
            {{ section.settings.no_products_text }}
          </p>
        {% endif %}
      {% else %}
        <div class="meditations__login-required">
          <h2>{{ section.settings.login_title }}</h2>
          <p>{{ section.settings.login_text }}</p>

          <a
            href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}"
            class="button-base button-secondary"
          >
            {{ section.settings.login_button_label }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
{% endcapture %}

{% render 'section', section: section, children: children %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('shopify-section-{{ section.id }}');

    if (!section) return;

    section.addEventListener('click', function(event) {
      const button = event.target.closest('.meditations__toggle');

      if (!button) return;

      const targetId = button.getAttribute('aria-controls');
      const target = document.getElementById(targetId);
      const iframe = target ? target.querySelector('iframe') : null;
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      const openLabel = button.dataset.openLabel || 'Beluister meditatie';
      const closeLabel = button.dataset.closeLabel || 'Sluit meditatie';

      if (!target) return;

      button.setAttribute('aria-expanded', String(!isOpen));
      target.hidden = isOpen;

      if (!isOpen && iframe && !iframe.src) {
        iframe.src = iframe.dataset.src;
      }

      button.textContent = isOpen ? openLabel : closeLabel;
    });
  });
</script>

{% schema %}
{
  "name": "Meditaties",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Meditatie collectie"
    },
    {
      "type": "text",
      "id": "open_button_label",
      "label": "Knoptekst openen",
      "default": "Beluister meditatie"
    },
    {
      "type": "text",
      "id": "close_button_label",
      "label": "Knoptekst sluiten",
      "default": "Sluit meditatie"
    },
    {
      "type": "text",
      "id": "missing_video_text",
      "label": "Tekst ontbrekende video",
      "default": "Deze meditatie is nog niet gekoppeld aan een video."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Tekst zonder aangekochte meditaties",
      "default": "Je hebt momenteel nog geen meditaties aangekocht."
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Knoplink zonder aangekochte meditaties"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Knoptekst zonder aangekochte meditaties",
      "default": "Bekijk meditaties"
    },
    {
      "type": "text",
      "id": "no_products_text",
      "label": "Tekst zonder producten in collectie",
      "default": "Er zijn momenteel geen meditaties beschikbaar."
    },
    {
      "type": "header",
      "content": "Login"
    },
    {
      "type": "text",
      "id": "login_title",
      "label": "Login titel",
      "default": "Log in om je meditaties te bekijken"
    },
    {
      "type": "textarea",
      "id": "login_text",
      "label": "Login tekst",
      "default": "Je meditaties zijn gekoppeld aan je klantaccount."
    },
    {
      "type": "text",
      "id": "login_button_label",
      "label": "Login knoptekst",
      "default": "Inloggen"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "column", "label": "t:options.vertical" },
        { "value": "row", "label": "t:options.horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        { "value": "", "label": "t:options.auto" },
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "full-screen", "label": "t:options.full_screen" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Meditaties",
      "category": "Custom"
    }
  ]
}
{% endschema %}