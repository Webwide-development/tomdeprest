{% capture children %}
  {% liquid
    assign meditation_collection = section.settings.collection
    assign has_access_to_any_meditation = false
  %}

  <div class="meditations">
    <div class="meditations__inner">
      {% if customer %}
        <div class="meditations__intro">
          <h1>{{ section.settings.title }}</h1>

          {% if section.settings.intro != blank %}
            <p>{{ section.settings.intro }}</p>
          {% endif %}
        </div>

        {% if meditation_collection and meditation_collection.products_count > 0 %}
          <div class="meditations__grid">
            {% for product in meditation_collection.products %}
              {% liquid
                assign vimeo_id = product.metafields.custom.vimeo_id.value
                assign required_tag = product.metafields.custom.customer_tag.value
                assign has_access = false

                if required_tag != blank and customer.tags contains required_tag
                  assign has_access = true
                  assign has_access_to_any_meditation = true
                endif
              %}

              {% if has_access %}
                <article class="meditations__card">
                  {% if product.featured_image != blank %}
                    <div class="meditations__image-wrapper">
                      <img
                        src="{{ product.featured_image | image_url: width: 900 }}"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="900"
                        height="506"
                      >
                    </div>
                  {% endif %}

                  <div class="meditations__content">
                    <h2>{{ product.title }}</h2>

                    {% if product.description != blank %}
                      <div class="meditations__description">
                        {{ product.description }}
                      </div>
                    {% endif %}

                    {% if vimeo_id != blank %}
                      <div class="meditations__video-wrapper">
                        <iframe
                          src="https://player.vimeo.com/video/{{ vimeo_id }}"
                          width="100%"
                          height="500"
                          frameborder="0"
                          allow="autoplay; fullscreen; picture-in-picture"
                          allowfullscreen
                          loading="lazy">
                        </iframe>
                      </div>
                    {% else %}
                      <p class="meditations__notice">
                        Deze meditatie is nog niet gekoppeld aan een video.
                      </p>
                    {% endif %}
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>

          {% unless has_access_to_any_meditation %}
            <div class="meditations__empty">
              <p>{{ section.settings.empty_text }}</p>

              {% if section.settings.empty_button_url != blank %}
                <a href="{{ section.settings.empty_button_url }}" class="meditations__button">
                  {{ section.settings.empty_button_label }}
                </a>
              {% endif %}
            </div>
          {% endunless %}
        {% else %}
          <p>{{ section.settings.no_products_text }}</p>
        {% endif %}
      {% else %}
        <div class="meditations__login-required">
          <h1>{{ section.settings.login_title }}</h1>
          <p>{{ section.settings.login_text }}</p>

          <a
            href="{{ routes.account_login_url }}?return_url={{ request.path }}"
            class="meditations__button"
          >
            {{ section.settings.login_button_label }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
{% endcapture %}

{% render 'section', section: section, children: children %}

{% stylesheet %}
  .meditations {
    color: rgb(var(--color-foreground));
  }

  .meditations__inner {
    width: min(100%, 980px);
    margin: 0 auto;
  }

  .meditations__intro,
  .meditations__empty,
  .meditations__login-required {
    max-width: 620px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .meditations__intro h1,
  .meditations__login-required h1 {
    margin: 0 0 14px;
    font-family: var(--font-heading-family);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .meditations__intro p,
  .meditations__empty p,
  .meditations__login-required p,
  .meditations__notice {
    margin: 0;
    color: rgba(var(--color-foreground), 0.72);
    font-size: 15px;
    line-height: 1.7;
  }

  .meditations__grid {
    display: grid;
    gap: 28px;
  }

  .meditations__card {
    display: grid;
    grid-template-columns: minmax(220px, 34%) 1fr;
    gap: 32px;
    align-items: center;
    padding: 28px;
    border: 1px solid rgba(var(--color-foreground), 0.16);
    background: rgb(var(--color-background));
  }

  .meditations__image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: rgba(var(--color-foreground), 0.04);
  }

  .meditations__image-wrapper img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meditations__content h2 {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    line-height: 1.15;
  }

  .meditations__description {
    max-width: 620px;
    margin-bottom: 22px;
    color: rgba(var(--color-foreground), 0.72);
    font-size: 14px;
    line-height: 1.7;
  }

  .meditations__description p {
    margin-top: 0;
  }

  .meditations__video-wrapper {
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .meditations__video-wrapper iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .meditations__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 22px;
    min-height: 42px;
    padding: 0 26px;
    border: 1px solid rgba(var(--color-foreground), 0.85);
    color: rgb(var(--color-foreground));
    background: transparent;
    text-decoration: none;
    font-size: 13px;
    line-height: 1;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease;
  }

  .meditations__button:hover {
    color: rgb(var(--color-background));
    background: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }

  .meditations__empty,
  .meditations__login-required {
    padding: 56px 24px;
    border: 1px solid rgba(var(--color-foreground), 0.14);
    background: rgba(var(--color-foreground), 0.025);
  }

  @media screen and (max-width: 749px) {
    .meditations__inner {
      width: 100%;
    }

    .meditations__intro,
    .meditations__empty,
    .meditations__login-required {
      margin-bottom: 36px;
    }

    .meditations__card {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 18px;
    }

    .meditations__content h2 {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Meditaties",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "collection",
        "id": "collection",
        "label": "Meditatie collectie"
    },
    {
        "type": "text",
        "id": "title",
        "label": "Titel",
        "default": "Mijn meditaties"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Hier vind je alle meditaties die je hebt aangekocht."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Tekst zonder aangekochte meditaties",
      "default": "Je hebt momenteel nog geen meditaties aangekocht."
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Knoplink zonder aangekochte meditaties"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Knoptekst zonder aangekochte meditaties",
      "default": "Bekijk meditaties"
    },
    {
      "type": "text",
      "id": "no_products_text",
      "label": "Tekst zonder producten in collectie",
      "default": "Er zijn momenteel geen meditaties beschikbaar."
    },
    {
      "type": "header",
      "content": "Login"
    },
    {
      "type": "text",
      "id": "login_title",
      "label": "Login titel",
      "default": "Log in om je meditaties te bekijken"
    },
    {
      "type": "textarea",
      "id": "login_text",
      "label": "Login tekst",
      "default": "Je meditaties zijn gekoppeld aan je klantaccount."
    },
    {
      "type": "text",
      "id": "login_button_label",
      "label": "Login knoptekst",
      "default": "Inloggen"
    },

    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "column", "label": "t:options.vertical" },
        { "value": "row", "label": "t:options.horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        { "value": "", "label": "t:options.auto" },
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "full-screen", "label": "t:options.full_screen" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Meditaties",
      "category": "Custom"
    }
  ]
}
{% endschema %}