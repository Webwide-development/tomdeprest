{% if customer %}

  <section class="meditations-page">
    <h1>{{ section.settings.title }}</h1>

    {% assign has_any_meditation = false %}

    {% for block in section.blocks %}
      {% if block.type == 'meditation' and customer.tags contains block.settings.customer_tag %}
        {% assign has_any_meditation = true %}

        <div class="meditation-item" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.title }}</h2>

          <iframe
            src="https://player.vimeo.com/video/{{ block.settings.vimeo_id }}"
            width="100%"
            height="500"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy">
          </iframe>
        </div>
      {% endif %}
    {% endfor %}

    {% unless has_any_meditation %}
      <p>{{ section.settings.empty_text }}</p>

      {% if section.settings.empty_button_url != blank %}
        <a href="{{ section.settings.empty_button_url }}">
          {{ section.settings.empty_button_label }}
        </a>
      {% endif %}
    {% endunless %}
  </section>

{% else %}

  {% comment %} <script> {% endcomment %}
    {% comment %} window.location.href = "/account/login?return_url={{ request.path }}"; {% endcomment %}
  {% comment %} </script> {% endcomment %}

{% endif %}


{% schema %}
{
  "name": "Meditations",
  "tag": "section",
  "class": "section-meditations",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Mijn meditaties"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Tekst zonder toegang",
      "default": "Je hebt momenteel nog geen meditaties aangekocht."
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Knoplink zonder toegang"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Knoptekst zonder toegang",
      "default": "Bekijk meditaties"
    }
  ],
  "blocks": [
    {
      "type": "meditation",
      "name": "Meditatie",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Diepe slaap meditatie"
        },
        {
          "type": "text",
          "id": "customer_tag",
          "label": "Customer tag",
          "default": "meditatie-slaap"
        },
        {
          "type": "text",
          "id": "vimeo_id",
          "label": "Vimeo video ID",
          "default": "123456789"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meditations",
      "blocks": [
        {
          "type": "meditation"
        }
      ]
    }
  ]
}
{% endschema %}