{%- doc -%}
  Renders a configurable button/link.

  @param {string} link - Link to render
  @param {object} block - Button block
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% assign button_width_class = 'button--fit' %}
{% assign button_width_mobile_class = 'button--fit-mobile' %}

{% if block_settings.width == 'custom' %}
  {% assign button_width_class = 'button--custom' %}
{% endif %}

{% if block_settings.width_mobile == 'custom' %}
  {% assign button_width_mobile_class = 'button--custom-mobile' %}
{% endif %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    button-base
    {{ block_settings.style_class }}
    {{ button_width_class }}
    {{ button_width_mobile_class }}
    {{ block_settings.style_class }}--{{ block.id }}
  "
  style="
    --button-custom-width: {{ block_settings.custom_width }}%;
    --button-custom-width-mobile: {{ block_settings.custom_width_mobile }}%;
  "
  {% if block_settings.open_in_new_tab %}
    target="_blank"
    rel="noopener noreferrer"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
</a>