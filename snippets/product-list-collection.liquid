<section class="product-list-collection-collection" style="
    --product-list-collection-width: {{ section.settings.product_list_content_width | default: 980 }}px;
    --product-list-collection-padding-top: {{ section.settings.product_list_padding_top | default: 48 }}px;
    --product-list-collection-padding-bottom: {{ section.settings.product_list_padding_bottom | default: 72 }}px;
    --product-list-collection-header-gap: {{ section.settings.product_list_header_gap | default: 92 }}px;
    --product-list-collection-heading-size: {{ section.settings.product_list_heading_size | default: 56 }}px;
    --product-list-collection-title-size: {{ section.settings.product_list_product_title_size | default: 26 }}px;
    --product-list-collection-text-color: {{ section.settings.product_list_text_color | default: '#403936' }};
    --product-list-collection-muted-color: {{ section.settings.product_list_muted_color | default: '#6d6460' }};
    --product-list-collection-border-color: {{ section.settings.product_list_border_color | default: '#dfcfc8' }};
    --product-list-collection-button-bg: {{ section.settings.product_list_button_background | default: '#453d39' }};
    --product-list-collection-button-color: {{ section.settings.product_list_button_text_color | default: '#ffffff' }};
">
  <div class="product-list-collection-collection__header">
    {% if section.settings.product_list_heading != blank %}
      <h1>{{ section.settings.product_list_heading }}</h1>
    {% endif %}

    {% if section.settings.product_list_text != blank %}
      <p>{{ section.settings.product_list_text }}</p>
    {% endif %}
  </div>

  {% assign selected_collection = section.settings.product_list_collection | default: collection %}

  {% if selected_collection != blank %}
    <ul class="product-list-collection-list" role="list">
      {% for product in selected_collection.products limit: section.settings.product_list_products_limit %}
        <li class="product-list-collection-list__item">
          <a class="product-list-collection-list__title" href="{{ product.url }}">
            {{ product.title }}
          </a>

          <div class="product-list-collection-list__meta">
            {% if section.settings.product_list_show_duration %}
              {% assign duration = product.metafields.custom.duration.value | default: section.settings.product_list_default_duration %}

              {% if duration != blank %}
                <span>{{ duration }}</span>
              {% endif %}
            {% endif %}

            {% if section.settings.product_list_show_price %}
              <span class="product-list-collection-list__price">
                {{ product.price | money_without_trailing_zeros }}
              </span>
            {% endif %}
          </div>

          {% assign current_variant = product.selected_or_first_available_variant %}
          {% assign can_add_to_cart = false %}

          {% if current_variant != blank and current_variant.available %}
            {% assign can_add_to_cart = true %}
          {% endif %}

          {% form 'product', product, class: 'product-list-collection-list__form' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">

            {% render 'add-to-cart-button',
              can_add_to_cart: can_add_to_cart,
              add_to_cart_text: section.settings.product_list_button_label,
              product: product,
              class: 'product-list-collection-list__button add-to-cart-button',
              id: 'ProductListAddToCart-' | append: section.id | append: '-' | append: product.id
            %}
          {% endform %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
